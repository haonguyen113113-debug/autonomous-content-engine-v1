{
  "schema_version": "1.0",
  "lock_mode": "locked",
  "palette": {
    "kit_red": "#C8102E",
    "kit_dark_red": "#7E0A1E",
    "ink": "#0B0D10",
    "chalk": "#F5F1E6",
    "navy": "#0A1A3C",
    "orange": "#E8590C",
    "winner_lime": "#8CFF00",
    "muted": "#9AA3A8",
    "signal_lime": "#8CFF00",
    "signal_orange": "#E8590C",
    "team_home": "#0A1A3C",
    "team_away": "#E8590C",
    "pitch_line": "#638C83",
    "deep_pitch": "#12211B"
  },
  "typography": {
    "display": {
      "family": "Barlow Condensed",
      "weights": [
        600,
        700
      ],
      "use": "Giant numerals, backdrop words, headers. Bundled cut has Vietnamese glyphs."
    },
    "brush": {
      "family": "PermanentMarker",
      "weights": [
        400
      ],
      "use": "Latin surnames/digits only on posters. Never Vietnamese copy."
    },
    "body": {
      "family": "Be Vietnam Pro",
      "weights": [
        400,
        600,
        700
      ],
      "use": "Vietnamese labels, micro provenance."
    },
    "rules": [
      "1 frame = 1 boss; max 3 type sizes.",
      "Winner numerals lime; ties both paper; color never carries meaning alone.",
      "Brush latin-only; Vietnamese stays Barlow/BeVietnam.",
      "Provenance whisper on every evidence plate."
    ]
  },
  "layout": {
    "safe_area_percent": {
      "top": 9,
      "bottom": 13,
      "left": 7,
      "right": 7
    },
    "caption_anchor": "No persistent subtitles; labels only when informative.",
    "hook_card": "Frame 0: 5-8 word claim, punched in, legible at 350px."
  },
  "motion": {
    "default_easing": "ease-out cubic, decisive stop.",
    "scene_enter": "Slide in from the right over 0.3s.",
    "count_up_steps": 6,
    "hook_stagger_seconds": 0.18,
    "manim_atoms": [
      "DuelColumns",
      "StatLeader",
      "PosterSide",
      "GoalPunch",
      "FixtureCard",
      "ScoreBug",
      "QuoteReveal",
      "WelcomeCard"
    ],
    "ticker": "Diagonal name tape drifts 1 loop per beat."
  },
  "audio": {
    "narration": "Primary; music ducks under speech."
  },
  "prohibited_effects": [
    "glitch",
    "screen shake",
    "rapid flashing",
    "fake scoreboard branding",
    "unlicensed club crests",
    "uncited stat graphics",
    "synthesized faces"
  ],
  "version": "9.0.0",
  "template_version": "9.0.0"
}
