{
  "schema_version": "1.0",
  "template_version": "11.0.0",
  "selection_rule": "Open on hook_card for beat 1; never repeat one mode more than twice in a short; every data beat carries source+date.",
  "modes": [
    {
      "id": "duel_columns",
      "purpose": "Compare sourced team/player metrics in duel columns.",
      "preferred_visual": "split-pitch duel, monogram crests, orange winner bars",
      "fallback": "source card if values missing"
    },
    {
      "id": "stat_leader",
      "purpose": "Press a short vertical stat list.",
      "preferred_visual": "white leader rows, monumental ink numerals, orange leader bar",
      "fallback": "hero statline if one number"
    },
    {
      "id": "player_poster_side",
      "purpose": "Introduce one player, side-split poster.",
      "preferred_visual": "fixed portrait slot + latin brush surname",
      "fallback": "typographic block"
    },
    {
      "id": "player_poster_top",
      "purpose": "Introduce one player, top-photo poster.",
      "preferred_visual": "fixed photo band + meta/stat columns",
      "fallback": "typographic block"
    },
    {
      "id": "goal_card",
      "purpose": "Mark a reviewed goal moment.",
      "preferred_visual": "mist backdrop word + ink chant + orange score pill",
      "fallback": "hook card"
    },
    {
      "id": "fixture_card",
      "purpose": "Announce one reviewed fixture.",
      "preferred_visual": "V + shield crest slots + orange provenance band",
      "fallback": "source card"
    },
    {
      "id": "fixture_list",
      "purpose": "List up to 3 reviewed fixtures.",
      "preferred_visual": "white rows, ink hairlines, orange next-marker",
      "fallback": "source card"
    },
    {
      "id": "score_card",
      "purpose": "Show a reviewed final score.",
      "preferred_visual": "locked prototype: white/orange split, monumental ink, badges",
      "fallback": "source card"
    },
    {
      "id": "quote_card",
      "purpose": "Surface one reviewed quote.",
      "preferred_visual": "fixed photo band + ink box + orange seal",
      "fallback": "source card"
    },
    {
      "id": "potm_card",
      "purpose": "Name a reviewed player of the match.",
      "preferred_visual": "monumental POTM + orange name pill",
      "fallback": "player poster"
    },
    {
      "id": "discipline_card",
      "purpose": "Show a reviewed card incident.",
      "preferred_visual": "edge letters + orange card motifs",
      "fallback": "source card"
    },
    {
      "id": "welcome_card",
      "purpose": "Welcome a reviewed signing/debut.",
      "preferred_visual": "X-cross field + fixed portrait square",
      "fallback": "player poster"
    },
    {
      "id": "hook_card",
      "purpose": "Decide frame 0 with one claim.",
      "preferred_visual": "slate kicker + one ink claim + orange rule",
      "fallback": "typographic question"
    },
    {
      "id": "tactical_explainer",
      "purpose": "Explain shape/run/press.",
      "preferred_visual": "authored white pitch plate",
      "fallback": "labeled diagram"
    },
    {
      "id": "source_card",
      "purpose": "Give a claim provenance.",
      "preferred_visual": "paper pull-quote",
      "fallback": "source-needed marker"
    },
    {
      "id": "conclusion",
      "purpose": "Land Allen's bounded takeaway.",
      "preferred_visual": "quiet branded close",
      "fallback": "one-sentence takeaway"
    }
  ],
  "annotation_rules": [
    "Every value supported by reviewed evidence.",
    "No auto-save/use of discovery results.",
    "No broadcast score-bug imitation or crests.",
    "Subtitles off; brief labels only when informative."
  ]
}
