# Copy this file to .env for local development.
# Never commit the real .env file.

APP_ENV=development
APP_NAME=autonomous-content-engine

ARTIFACT_ROOT=./runtime/artifacts

LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:2b
OLLAMA_BASE_URL=http://localhost:11434

# Optional cloud drafting when local inference is too weak or slow.
# Keep Ollama as the default; switch per machine by changing these lines.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=
# Rotation chain: when a model hits rate limits, quota, or server errors,
# the engine moves to the next id automatically (401 fails fast instead).
# Unknown ids are skipped; limited models cool down for LLM_COOLDOWN_SECONDS
# (or the provider's Retry-After header when longer).
# On OpenRouter free models: 20 requests/min and 50 requests/day shared
# across free models (1000/day after buying $10+ credits once). Listing more
# models spreads per-minute/provider load, not the daily cap.
# LLM_MODELS=model-a,model-b,model-c
# LLM_COOLDOWN_SECONDS=300
# LLM_API_KEY=
# --- Groq preset (very fast free tier; verify ids at console.groq.com/docs/models) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
# Cap per-draft model spend in USD (default 0.25). Outline fallback applies.
# LLM_BUDGET_USD_PER_RUN=0.25
# Exact per-1M-token prices override the built-in indicative table.
# LLM_PRICE_PER_M_IN=
# LLM_PRICE_PER_M_OUT=

# Optional when FFmpeg is not on PATH; set a local executable path per machine.
FFMPEG_PATH=

# Optional: free Pexels API key (https://www.pexels.com/api/) unlocks extra
# image and video discovery. 200 requests/hour + 20,000/month on the free
# tier; credit photographers when possible ("Photo by X on Pexels").
# Optional: free Pixabay API key (https://pixabay.com/api/docs/) as a second
# keyed source. 100 requests/minute; show where results come from.
# Without keys, Openverse + Wikimedia Commons run.
PEXELS_API_KEY=
PIXABAY_API_KEY=

WORKER_ID=local-dev
WORKER_POLL_SECONDS=15
