# Copy this file to .env for local development.
# Never commit the real .env file.

APP_ENV=development
APP_NAME=autonomous-content-engine

ARTIFACT_ROOT=./runtime/artifacts

LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:2b
OLLAMA_BASE_URL=http://localhost:11434

# Optional when FFmpeg is not on PATH; set a local executable path per machine.
FFMPEG_PATH=

# Optional: free Pexels API key (https://www.pexels.com/api/) unlocks extra
# image and video discovery. Without it, Openverse + Wikimedia Commons run.
PEXELS_API_KEY=

WORKER_ID=local-dev
WORKER_POLL_SECONDS=15
